CORS_ORIGINS=http://localhost:5173
# Connection URL for the dedicated portal database. Percent-encode the password.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:url-encoded-password@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key for no-email password recovery.
SUPABASE_SECRET_KEY=
# Use 0 for local HTTP only. HTTPS deployments must use 1.
AUTH_COOKIE_SECURE=0
